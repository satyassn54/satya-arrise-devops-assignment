{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AuthenticateToECR",
            "Effect": "Allow",
            "Action": [
                "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowECRPushAndPull",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:InitiateLayerUpload",
                "ecr:UploadLayerPart",
                "ecr:CompleteLayerUpload",
                "ecr:PutImage",
                "ecr:BatchGetImage"
            ],
            "Resource": "arn:aws:ecr:us-east-1:000000000000:repository/arrise-ecr-repo"
        },
        {
      	    "Sid": "RegisterTaskDefinition",
      	    "Effect": "Allow",
      	    "Action": [
        	"ecs:RegisterTaskDefinition",
        	"ecs:DescribeTaskDefinition"
      	    ],
      	    "Resource": "*"
    	},
    	{
	     "Sid": "DeployToSpecificECSService",
             "Effect": "Allow",
      	     "Action": [
        	"ecs:UpdateService",
        	"ecs:DescribeServices"
      	     ],
      	     "Resource": "arn:aws:ecs:us-east-1:000000000000:service/your-cluster-name/your-service-name"
    	},
        {
            "Sid": "PassOnlyApprovedTaskExecutionRole",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": "arn:aws:iam::000000000000:role/your-ecs-task-execution-role",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            }
        },
        {
            "Sid": "AllowReadS3BuildArtifacts",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::your-build-artifacts-bucket-name/*"
            ]
        },
	{
            "Sid": "ListBuildArtifactsBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::your-build-artifacts-bucket-name"
            ]
        }
    ]
}
